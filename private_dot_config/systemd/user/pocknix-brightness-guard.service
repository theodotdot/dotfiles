[Unit]
Description=Pocknix: restart the shell once if it started before PowerDevil
# plasmashell takes PowerDevil's brightness object at construction and never re-checks, so a
# shell that wins the race hides the quick-settings slider for the whole session. Ordering
# plasmashell after powerdevil is not possible (ordering cycle via plasma-core.target), so
# this waits for the interface afterwards and restarts the shell if the log says it missed it.
After=plasma-powerdevil.service plasma-plasmashell.service
Wants=plasma-powerdevil.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.config/scripts/pocknix-brightness-guard
# The check is a single pass; a failure here must not hold up anything else.
SuccessExitStatus=0 1

[Install]
WantedBy=graphical-session.target
