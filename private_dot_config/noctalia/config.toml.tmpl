[bar.default]
background_opacity = 0.74999998323619366
border = "primary"
center = [ "group:g1" ]
end = [ "caffeine", "network", "volume", "tray", "notifications", "session" ]
margin_edge = 3
margin_ends = 12 # Thor panels are 960x540 (DSI-2) and 620x540 (DSI-1) logical; 550 was sized for a 2560-wide DP-2
margin_opposite_edge = 3
radius = 20
shadow = false
start = [ "workspaces", "keyboard_layout", "media" ]
widget_spacing = 10

    [bar.default.dead_zone.actions]
    left = "panel-toggle control-center home"
    right = "annotate"

    [[bar.default.capsule_group]]
    accordion = true
    accordion_direction = "end"
    border_width = 0.0
    enabled = true
    fill = "surface_variant"
    id = "g1"
    members = [ "clock", "weather" ]
    opacity = 1.0
    padding = 9.0

    # The Thor's only external output is DP-1 (msm exposes DP-1; DSI-1/DSI-2 are the panels).
    # Noctalia builds a bar on every connected monitor, so the external gets one automatically;
    # this block only gives it its own inset, and is where any monitor-specific override goes.
    [bar.default.monitor."DP-1"]
    match = "DP-1"
    enabled = true
    margin_ends = 100 # px; a monitor override must be an integer (percentages are bar-level only)

    # Bottom panel (DSI-1) gets no bar: it is used as a secondary screen in the desktop session.
    [bar.default.monitor."DSI-1"]
    match = "DSI-1"
    enabled = false

[battery.device."/org/freedesktop/UPower/devices/keyboard_dev_CF_F7_A1_B2_07_60"]
warning_threshold = 10

[brightness]
enable_ddcutil = true

[calendar]

[control_center.calendar]
show_events_card = false

[[control_center.shortcuts]]
type = "wifi"

[[control_center.shortcuts]]
type = "bluetooth"

[[control_center.shortcuts]]
type = "caffeine"

[[control_center.shortcuts]]
type = "notification"

[[control_center.shortcuts]]
type = "power_profile"

[[control_center.shortcuts]]
type = "audio"

[desktop_widgets]
schema_version = 2
widget_order = []

    [desktop_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

    [desktop_widgets.widget]

[idle]
behavior_order = [ "screen-off", "lock", "suspend" ]
pre_action_fade_seconds = 2.0

    [idle.behavior.lock]
    action = "lock"
    enabled = false
    timeout = 900

    [idle.behavior.screen-off]
    action = "screen_off"
    enabled = true
    timeout = 1200

    [idle.behavior.suspend]
    action = "lock_and_suspend"
    enabled = false
    timeout = 1800

[location]
address = "Berlin, Germany"

[lockscreen]
allow_empty_password = false
blur_intensity = 0.5
blurred_desktop = false
edge_smoothness = 0.29999999999999999
enabled = true
fingerprint = false
lock_before_suspend = true
monitors = []
tint_intensity = 0.29999999999999999
transition = [ "fade" ]
transition_duration = 1500
wallpaper = ""

[lockscreen_widgets]
enabled = false
schema_version = 2
widget_order = []

    [lockscreen_widgets.grid]
    cell_size = 16
    major_interval = 4
    visible = true

[notification]
background_opacity = 0.75
history_retention_hours = 48
layer = "overlay"

[osd]
border = false

[shell]
app_icon_color = "primary"
avatar_path = "/home/{{ .chezmoi.username }}/Downloads/momo.png"
clipboard_auto_paste = "off"
font_family = "MonoLisa Nerd Font"
polkit_agent = true
popup_shadows = false
settings_window_translucent = true

    [shell.animation]
    speed = 1.2500000186264515

    [shell.greeter_sync]
    auto_sync = true

    [shell.keyboard_layout.custom_labels]
    "English (US, intl., with dead keys)" = "usintl"
    "French (Ergo‑L)" = "ergol"

    [shell.launcher]
    categories = false
    compact = true
    fetch_exchange_rates = false
    show_app_origin_indicator = false
    show_icons = true

        [shell.launcher.providers.calculator]
        global = false

    [shell.screenshot]
    annotate = true
    confirm_region = true
    save_to_file = false
    show_cursor = true
    skip_annotate_on_copy_save = true

    [shell.session]
    show_shortcuts = false

    [shell.panel]
    transparency_mode = "soft"

    [shell.shadow]
    alpha = 0.0

[theme]
builtin = "Catppuccin"
community_palette = "Catppuccin Macchiato Mauve"
mode = "dark"
source = "community"

    [theme.templates]
    builtin_ids = [ "gtk3", "gtk4", "kcolorscheme", "qt" ]

[wallpaper]
directory = "/home/{{ .chezmoi.username }}/Downloads/walls"

    [wallpaper.automation]
    enabled = false

    [wallpaper.default]
    path = "/home/{{ .chezmoi.username }}/Downloads/walls/anime-forest_catppuccin-macchiato.png"

    [wallpaper.last]
    path = "/home/{{ .chezmoi.username }}/Downloads/walls/anime-forest_catppuccin-macchiato.png"

    [wallpaper.monitors.DSI-2]
    path = "/home/{{ .chezmoi.username }}/Downloads/walls/anime-forest_catppuccin-macchiato.png"

[widget.clock]
format = "%A, %d %B  %H:%M "

[widget.keyboard_layout]
icon_color = "primary"

[widget.media]
hide_when_no_media = true
icon_color = "primary"
title_scroll = "on_hover"

[widget.network]
show_label = false

[widget.tray]
drawer = true
icon_color = "primary"
match_adjacent_spacing = true

[widget.weather]
icon_color = "primary"

[widget.workspaces]
empty_color = "surface_variant"
label_source = "name"
labels_only_when_occupied = true
max_label_chars = 5
occupied_color = "surface_variant"
scale = 1.05
show_tooltip = false
