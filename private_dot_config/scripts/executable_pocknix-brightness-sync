#!/usr/bin/env python3
"""pocknix-brightness-sync — keep the Thor's bottom panel in step with the top.

Both panels are put on the same *percentage* by whatever owns brightness, but the two
backlights do not share a curve (both report type=raw, scale=unknown), so at low levels the
620x540 bottom panel (ae94000.dsi.0, 0..255) reads brighter than the 1920x1080 top panel
(ae96000.dsi.0, 0..3413). At 40 % on both, the bottom is visibly the brighter screen.

The top panel therefore stays the reference and the bottom one is re-driven through

    bottom = round(bottom_max * (top / top_max) ** GAMMA)

GAMMA went 1.6 -> 2.0 -> 2.2 -> 2.7 as the bottom kept reading brighter at low levels. The curve only has to satisfy "both look equal at every level", and only the person
looking at the panels can settle it, so the value can also be set live, without restarting:
`echo GAMMA=2.4 > ~/.config/pocknix/brightness-sync.conf` is picked up on the next change.
POCKNIX_BRIGHTNESS_GAMMA overrides both for a one-off test.

Correcting *after* kwin writes both panels means the bottom is briefly on kwin's linear
value, which reads as a flash. So this does not poll and it does not chase kwin either: it
subscribes to org.kde.ScreenBrightness.BrightnessChanged and coalesces the burst of changes
a slider drag produces, correcting once the value has been quiet for DEBOUNCE. During the
drag the bottom simply follows kwin, then it settles onto the curve. Costs nothing while
idle, and nothing when no kwin is running (Game Mode).

Known limit: the bottom panel's brightness write costs ~33 ms, so correcting after kwin's
write is always a visible (if short) overshoot. Applying the curve inside the panel driver
would remove both the helper and the flash; that needs the kernel rebuilt.

Game Mode is left alone: gamescope only drives the top panel and SteamOS has no dual-screen
support yet, so the bottom is not written at all while a gamescope process exists.
"""

from __future__ import annotations

import os
import subprocess
import time

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

BACKLIGHT = "/sys/class/backlight"
TOP = os.environ.get("POCKNIX_BRIGHTNESS_TOP", "ae96000.dsi.0")
BOTTOM = os.environ.get("POCKNIX_BRIGHTNESS_BOTTOM", "ae94000.dsi.0")
DEFAULT_GAMMA = 2.7
GAMMA = float(os.environ.get("POCKNIX_BRIGHTNESS_GAMMA", DEFAULT_GAMMA))
# Live tuning knob, re-read on every correction so the service does not need a restart.
CONFIG = os.path.expanduser("~/.config/pocknix/brightness-sync.conf")
# kwin animates a slider drag as many sysfs writes (up to ~0.5 s for a full-range jump) and
# its signals can arrive before the animation, so waiting after the last signal lands
# mid-animation and gets overwritten — the bottom then stays bright and settles late.
# Instead chase the animation: after a signal, re-read the top every CHASE_STEP and re-apply
# the curve whenever kwin has just overwritten the bottom, for up to CHASE_TIME.
#
# The chase cannot hide the transient: writing /sys/class/backlight/ae94000.dsi.0/brightness
# costs ~33 ms (a DSI round trip to the AMOLED controller; reads are 0.02 ms), so a second
# write can never land in the same frame as kwin's. Only the panel driver can avoid it —
# see the kernel note in README.md.
CHASE_STEP = 0.005
CHASE_TIME = 1.0
# Safety net for brightness written by something other than kwin; the signals do the work.
SAFETY_INTERVAL = 30
# How long a "is gamescope running" answer is trusted.
GAME_MODE_TTL = 2.0

_game_mode = (0.0, False)


def gamma() -> float:
    """Curve exponent: the built-in constant unless the tuning file says otherwise."""
    try:
        with open(CONFIG) as handle:
            for line in handle:
                key, _, value = line.partition("=")
                if key.strip() == "GAMMA":
                    return float(value)
    except (OSError, ValueError):
        pass
    return GAMMA


def read_int(path: str) -> int:
    with open(path) as handle:
        return int(handle.read().strip())


def in_game_mode() -> bool:
    """True while a gamescope session owns the screen (its process appears then)."""
    global _game_mode
    stamp, cached = _game_mode
    now = time.monotonic()
    if now - stamp < GAME_MODE_TTL:
        return cached

    found = False
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open(f"/proc/{entry}/comm") as handle:
                    if handle.read().strip() == "gamescope":
                        found = True
                        break
            except OSError:
                continue
    except OSError:
        pass
    _game_mode = (now, found)
    return found


def write_bottom(value: int) -> bool:
    """Set the bottom panel, returning whether the value is really in effect.

    The bottom panel's driver answers EINVAL from the sysfs write while still applying
    the value, so the exit status means nothing here: the read-back does.
    """
    path = f"{BACKLIGHT}/{BOTTOM}/brightness"
    try:
        with open(path, "w") as handle:
            handle.write(str(value))
    except OSError:
        pass
    try:
        if read_int(path) == value:
            return True
    except (OSError, ValueError):
        return False

    # Fall back to logind, which authorises the caller's own session and needs no sudo;
    # it is what kwin/PowerDevil use on the same attribute.
    subprocess.run(
        [
            "busctl", "--system", "call", "org.freedesktop.login1",
            "/org/freedesktop/login1/session/auto",
            "org.freedesktop.login1.Session",
            "SetBrightness", "ssu", "backlight", BOTTOM, str(value),
        ],
        check=False,
        capture_output=True,
    )
    try:
        return read_int(path) == value
    except (OSError, ValueError):
        return False


_maxima = None


def maxima() -> tuple[int, int] | None:
    """max_brightness for both panels; constant, so read once."""
    global _maxima
    if _maxima is None:
        try:
            top_max = read_int(f"{BACKLIGHT}/{TOP}/max_brightness")
            bottom_max = read_int(f"{BACKLIGHT}/{BOTTOM}/max_brightness")
        except (OSError, ValueError):
            return None
        if top_max <= 0 or bottom_max <= 0:
            return None
        _maxima = (top_max, bottom_max)
    return _maxima


def correct(*_args, **_kwargs) -> None:
    """Bring the bottom panel to the curve for the top panel's current level."""
    if in_game_mode():
        return
    try:
        sizes = maxima()
        if sizes is None:
            return
        top_max, bottom_max = sizes

        level = min(1.0, max(0.0, read_int(f"{BACKLIGHT}/{TOP}/brightness") / top_max))
        target = max(1, round(bottom_max * level ** gamma()))
        if read_int(f"{BACKLIGHT}/{BOTTOM}/brightness") != target:
            write_bottom(target)
    except (OSError, ValueError):
        # Panel briefly missing (mode switch); the next signal or safety pass retries.
        return


_pending = None
_deadline = 0.0


def schedule(*_args, **_kwargs) -> None:
    """Start (or extend) the chase window when kwin reports a change."""
    global _pending, _deadline
    _deadline = time.monotonic() + CHASE_TIME
    if _pending is None:
        _pending = GLib.timeout_add(int(CHASE_STEP * 1000), _chase)


def _chase() -> bool:
    """Re-apply the curve for as long as kwin is still animating."""
    global _pending
    correct()

    if time.monotonic() >= _deadline:
        _pending = None
        return False
    return True


def main() -> int:
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    bus.add_signal_receiver(
        schedule,
        signal_name="BrightnessChanged",
        dbus_interface="org.kde.ScreenBrightness",
    )

    def watchdog() -> bool:
        correct()
        # Leave if the session bus went away; Restart=always brings us back on the new one.
        return bool(bus.get_is_connected())

    GLib.timeout_add_seconds(SAFETY_INTERVAL, watchdog)
    correct()
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
