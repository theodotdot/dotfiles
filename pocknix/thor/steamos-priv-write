#!/usr/bin/env bash
# steamos-priv-write — the privileged-write helper SteamOS's Steam client expects.
#
# Steam (steamclient.so / steamui.so) drives the brightness slider by running
#   /usr/bin/steamos-polkit-helpers/steamos-priv-write /sys/class/backlight/<dev>/brightness <value>
# and falls back to `echo <value> | sudo -n tee <path>` when that binary is missing. pocknix
# ships the other steamos-polkit-helpers but not this one, so Game Mode ended up in the sudo
# fallback, which fails ("a password is required") — and even when it succeeds it targets
# whatever /sys/class/backlight lists first, which on the Thor is the bottom panel while Game
# Mode runs on the top one.
#
# This answers the brightness case only: the value is rescaled from the panel Steam asked
# about into the panel gamescope drives, then written through logind (session-authorized, no
# password) or straight to sysfs when the backlight is writable.
set -euo pipefail

path="${1-}"
value="${2-}"

# Panel Game Mode actually drives: top panel, DSI-2. Armada's ayn-thor.conf calls this
# ARMADA_PRIMARY_BACKLIGHT; override with POCKNIX_BRIGHTNESS_DEVICE when that changes.
primary="${POCKNIX_BRIGHTNESS_DEVICE:-ae96000.dsi.0}"

if [[ ! $path =~ ^/sys/class/backlight/([[:alnum:]_.:-]+)/brightness$ ]]; then
    echo "steamos-priv-write: unsupported path: ${path}" >&2
    exit 1
fi
# Capture now: the value check below resets BASH_REMATCH.
device="${BASH_REMATCH[1]}"
if [[ ! $value =~ ^[0-9]+$ ]]; then
    echo "steamos-priv-write: invalid backlight value: ${value}" >&2
    exit 1
fi

source_dev="/sys/class/backlight/${device}"
target_dev="/sys/class/backlight/${primary}"
for f in "${source_dev}/max_brightness" "${target_dev}/max_brightness"; do
    [[ -r $f ]] || { echo "steamos-priv-write: cannot read ${f}" >&2; exit 1; }
done

source_max="$(<"${source_dev}/max_brightness")"
target_max="$(<"${target_dev}/max_brightness")"
if (( source_max <= 0 || target_max <= 0 )); then
    echo "steamos-priv-write: invalid backlight range" >&2
    exit 1
fi

# Steam truncates its request; clamp, then rescale across the two panels' ranges.
(( value > source_max )) && value="$source_max"
scaled=$(( value * target_max / source_max ))
(( scaled < 1 )) && scaled=1

set_brightness() { # device, raw value
    local dev="/sys/class/backlight/${1}" raw="$2"
    # The bottom panel's driver (ae94000) rejects the sysfs write with EINVAL while still
    # applying the value, so success is judged by reading it back rather than by the write.
    printf '%s' "$raw" >"${dev}/brightness" 2>/dev/null || true
    [[ "$(<"${dev}/brightness")" == "$raw" ]] && return 0

    # logind authorizes the active session and coalesces overlapping writes, so this
    # works without sudo or a polkit prompt.
    busctl --system call org.freedesktop.login1 \
        /org/freedesktop/login1/session/auto org.freedesktop.login1.Session \
        SetBrightness ssu backlight "${1}" "${raw}" >/dev/null 2>&1 || true
    [[ "$(<"${dev}/brightness")" == "$raw" ]]
}

if ! set_brightness "${primary}" "${scaled}"; then
    echo "steamos-priv-write: cannot set ${primary} to ${scaled}" >&2
    exit 1
fi

# The bottom panel Steam names is deliberately not written: pocknix-brightness-sync owns it
# and drives it through a gamma curve so both panels look equally bright. Writing it here
# would fight that helper at 5 Hz.

